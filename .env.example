# BOB 프로젝트의 Settings > API Keys에서 공개 키 한 가지를 입력하세요.
NEXT_PUBLIC_SUPABASE_URL=https://vqqolzpodmaibnjazxus.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 기존 anon 역할 JWT를 사용하는 배포에서만 입력하세요.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Edge Functions의 서버 자격 증명은 Supabase에서 관리합니다.
# 휴대폰 알림(Web Push) 공개키. Edge Functions 비밀값 VAPID_PUBLIC_KEY와 같은 값
# (개인키 VAPID_PRIVATE_KEY·VAPID_SUBJECT는 Supabase Edge Functions Secrets에만 둔다)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
