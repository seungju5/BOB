rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Verified members can only access their own account and its selected records.
    function b3Verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    // Membership can be provisioned only with the project management credentials.
    function studioOperator() {
      return b3Verified() && request.auth.token.email is string
        && exists(/databases/$(database)/documents/bapmunnaOperators/$(request.auth.token.email.lower()))
        && get(/databases/$(database)/documents/bapmunnaOperators/$(request.auth.token.email.lower())).data.enabled == true;
    }
    match /bapmunnaOperators/{email} {
      allow get: if b3Verified() && request.auth.token.email.lower() == email;
    }
    match /bapmunnaOpsMeta/directory { allow get: if studioOperator(); }
    match /bapmunnaMemberDirectory/{uid} {
      function self() { return request.auth != null && request.auth.uid == uid && request.auth.token.email is string; }
      function matchesToken(d) {
        return d.email == request.auth.token.email && d.emailLower == request.auth.token.email.lower()
          && d.verified == request.auth.token.email_verified && d.lastLoginAt is timestamp
          && d.lastLoginAt.toMillis() == request.auth.token.auth_time * 1000;
      }
      allow get: if self() || studioOperator();
      allow list: if studioOperator();
      allow create: if self() && request.resource.data.keys().hasOnly(['email','emailLower','verified','joinedAt','lastLoginAt'])
        && matchesToken(request.resource.data) && request.resource.data.joinedAt == request.time;
      allow update: if self() && matchesToken(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email','emailLower','verified','lastLoginAt'])
        && (!('lastLoginAt' in resource.data) || resource.data.lastLoginAt <= request.resource.data.lastLoginAt);
    }
    match /bapmunnaStorageStatus/{uid} {
      function matchesSource(changed) {
        let d = request.resource.data;
        return d.keys().hasOnly(['settingsAt','householdAt']) && d.keys().hasAny(['settingsAt','householdAt'])
          && (!changed.hasAny(['settingsAt']) || (d.settingsAt == request.time
            && getAfter(/databases/$(database)/documents/bapmunnaAccounts/$(uid)/preferences/settings).data.updatedAt == request.time))
          && (!changed.hasAny(['householdAt']) || (d.householdAt == request.time
            && getAfter(/databases/$(database)/documents/bapmunnaAccounts/$(uid)/preferences/household).data.updatedAt == request.time));
      }
      allow get: if studioOperator();
      allow create: if b3Owner(uid) && matchesSource(request.resource.data.keys());
      allow update: if b3Owner(uid) && matchesSource(request.resource.data.diff(resource.data).affectedKeys());
    }
    match /bapmunnaOpsCases/{uid} {
      allow get: if studioOperator();
      allow create,update: if studioOperator()
        && (exists(/databases/$(database)/documents/bapmunnaMemberDirectory/$(uid)) || exists(/databases/$(database)/documents/bapmunnaAccounts/$(uid)))
        && request.resource.data.keys().hasOnly(['stage','note','editedBy','updatedAt'])
        && request.resource.data.stage in ['new','review','done']
        && request.resource.data.note is string && request.resource.data.note.size() <= 500
        && request.resource.data.editedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
    }
    function b3Owner(uid) { return b3Verified() && request.auth.uid == uid; }
    function b3Profile(d,uid) {
      return d.keys().hasAll(['ownerUid','email','displayName','consentVersion','createdAt','updatedAt'])
        && d.keys().hasOnly(['ownerUid','email','displayName','consentVersion','createdAt','updatedAt'])
        && d.ownerUid == uid && d.email == request.auth.token.email
        && d.displayName is string && d.displayName.size() >= 2 && d.displayName.size() <= 30
        && d.consentVersion == '2026-10-16' && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    match /bapmunnaAccounts/{uid} {
      allow read: if b3Owner(uid) || studioOperator();
      allow update: if studioOperator() && resource.data.ownerUid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','updatedAt'])
        && request.resource.data.displayName is string && request.resource.data.displayName == request.resource.data.displayName.trim()
        && request.resource.data.displayName.size() >= 2 && request.resource.data.displayName.size() <= 30
        && request.resource.data.updatedAt == request.time;
      allow create: if b3Owner(uid) && b3Profile(request.resource.data,uid)
        && request.resource.data.createdAt == request.time;
      allow update: if b3Owner(uid) && b3Profile(request.resource.data,uid)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
      // Basic preferences belong only to the verified account owner. They do
      // not create a care household, sharing grant, or senior consent record.
      match /preferences/household {
        function validHousehold(d) {
          return d.keys().hasAll(['ownerUid','relation','alias','residentCount','hasPet','updatedAt'])
            && d.keys().hasOnly(['ownerUid','relation','alias','residentCount','hasPet','updatedAt'])
            && d.ownerUid == uid
            && d.relation in ['mother','father','parents','other']
            && d.alias is string && d.alias.size() >= 1 && d.alias.size() <= 30
            && d.alias == d.alias.trim()
            && d.residentCount is int && d.residentCount >= 1 && d.residentCount <= 6
            && d.hasPet is bool && d.updatedAt == request.time;
        }
        allow read: if b3Owner(uid);
        // The app can acknowledge and save the household in one atomic transaction.
        allow create,update: if b3Owner(uid) && validHousehold(request.resource.data)
          && getAfter(/databases/$(database)/documents/bapmunnaAccounts/$(uid)/preferences/settings).data.preparationAcknowledged == true;
        allow delete: if b3Owner(uid);
      }
      // Private preferences only: no family access, sensor access, or consent grant.
      match /preferences/settings {
        function window(w) {
          return w is map && w.keys().hasAll(['slot','start','end'])
            && w.keys().hasOnly(['slot','start','end'])
            && w.slot in ['breakfast','lunch','dinner','fourth','fifth']
            && w.start is string && w.end is string
            && w.start.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
            && w.end.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') && w.start < w.end;
        }
        function windows(w) {
          return w is list && w.size() >= 1 && w.size() <= 5 && window(w[0])
            && (w.size() < 2 || (window(w[1]) && w[0].end <= w[1].start && w[0].slot != w[1].slot))
            && (w.size() < 3 || (window(w[2]) && w[1].end <= w[2].start && w[2].slot != w[0].slot && w[2].slot != w[1].slot))
            && (w.size() < 4 || (window(w[3]) && w[2].end <= w[3].start && w[3].slot != w[0].slot && w[3].slot != w[1].slot && w[3].slot != w[2].slot))
            && (w.size() < 5 || (window(w[4]) && w[3].end <= w[4].start && !(w[4].slot in [w[0].slot,w[1].slot,w[2].slot,w[3].slot])));
        }
        function validSettings(d) {
          return d.keys().hasAll(['ownerUid','schemaVersion','onboardingStep','phone','relationLabel','windows','eatOutPerWeek','usesKeepWarm','cooksPerWeek','missedMealsThreshold','fastingHours','emergencyHours','preparationAcknowledged','updatedAt'])
            && d.keys().hasOnly(['ownerUid','schemaVersion','onboardingStep','phone','relationLabel','windows','eatOutPerWeek','usesKeepWarm','cooksPerWeek','missedMealsThreshold','fastingHours','emergencyHours','preparationAcknowledged','updatedAt'])
            && d.ownerUid == uid && d.schemaVersion == 1
            && d.onboardingStep is int && d.onboardingStep >= 1 && d.onboardingStep <= 8
            && d.phone is string && d.phone.size() <= 24 && d.phone.matches('^[+]?[0-9 ()-]*$')
            && d.relationLabel is string && d.relationLabel.size() <= 30 && d.relationLabel == d.relationLabel.trim()
            && windows(d.windows) && d.usesKeepWarm is bool && d.preparationAcknowledged is bool
            && d.eatOutPerWeek is int && d.eatOutPerWeek >= 0 && d.eatOutPerWeek <= 20
            && d.cooksPerWeek is int && d.cooksPerWeek >= 1 && d.cooksPerWeek <= 21
            && d.missedMealsThreshold is int && d.missedMealsThreshold >= 1 && d.missedMealsThreshold <= 6
            && d.fastingHours is int && d.fastingHours >= 12 && d.fastingHours <= 108 && d.fastingHours % 6 == 0
            && d.emergencyHours is int && d.emergencyHours >= 24 && d.emergencyHours <= 120 && d.emergencyHours % 6 == 0
            && d.emergencyHours - d.fastingHours >= 12 && d.updatedAt == request.time;
        }
        allow read: if b3Owner(uid);
        allow create: if b3Owner(uid) && validSettings(request.resource.data)
          && (request.resource.data.preparationAcknowledged || (request.resource.data.phone == ''
            && request.resource.data.relationLabel == '' && request.resource.data.onboardingStep <= 3));
        allow update: if b3Owner(uid) && validSettings(request.resource.data)
          && (resource.data.onboardingStep < 8 || request.resource.data.onboardingStep == 8)
          && (request.resource.data.preparationAcknowledged
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['preparationAcknowledged','updatedAt','onboardingStep'])
              && (request.resource.data.onboardingStep == resource.data.onboardingStep || request.resource.data.onboardingStep <= 3)));
        allow delete: if b3Owner(uid);
      }
      // A verified household confirms each screenshot locally. One immutable
      // threshold result per second, within 35 Seoul calendar days.
      match /meterCaptures/{bucket} {
        function consent() {
          return b3Owner(uid)
            && get(/databases/$(database)/documents/bapmunnaAccounts/$(uid)).data.consentVersion == '2026-10-16'
            && get(/databases/$(database)/documents/bapmunnaAccounts/$(uid)/preferences/settings).data.preparationAcknowledged == true;
        }
        function validSample(d) {
          let today = int((request.time.toMillis() + 32400000) / 86400000);
          return d.keys().hasOnly(['day','key','samples','windows'])
            && d.day is int && d.day <= today && d.day > today - 35
            && bucket.matches('^(0|[1-9][0-9]?)$') && int(bucket) == d.day % 35
            && d.key is string && d.key.matches('^(0|[1-9][0-9]{0,4})$') && int(d.key) < 86400
            && (d.day * 86400 + int(d.key) - 32400) * 1000 <= request.time.toMillis()
            && d.samples is map && d.samples[d.key] is bool;
        }
        function first(d) {
          return d.samples.keys().hasOnly([d.key])
            && d.windows == get(/databases/$(database)/documents/bapmunnaAccounts/$(uid)/preferences/settings).data.windows;
        }
        function staysGranted() {
          return getAfter(/databases/$(database)/documents/bapmunnaAccounts/$(uid)/preferences/settings).data.preparationAcknowledged == true;
        }
        allow read: if consent();
        allow create: if consent() && staysGranted() && validSample(request.resource.data) && first(request.resource.data);
        allow update: if consent() && staysGranted() && validSample(request.resource.data)
          && ((request.resource.data.day > resource.data.day && first(request.resource.data))
            || (request.resource.data.day == resource.data.day && request.resource.data.windows == resource.data.windows
              && !(request.resource.data.key in resource.data.samples)
              && request.resource.data.samples.diff(resource.data.samples).affectedKeys().hasOnly([request.resource.data.key])));
        allow delete: if b3Owner(uid);
      }
      match /meals/{mealId} {
        function currentSeoulDay(d) {
          let parts = d.day.split('-');
          let today = request.time + duration.value(9,'h');
          return int(parts[0]) == today.year() && int(parts[1]) == today.month()
            && int(parts[2]) == today.day()
            && d.dayStart == today.date() - duration.value(9,'h');
        }
        function validMeal(d) {
          return d.keys().hasAll(['ownerUid','day','meal','kind','dayStart','createdAt','updatedAt'])
            && d.keys().hasOnly(['ownerUid','day','meal','kind','dayStart','createdAt','updatedAt'])
            && d.ownerUid == uid && d.day is string && d.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && d.meal in ['breakfast','lunch','dinner'] && d.kind in ['home','outside']
            && mealId == d.day + '_' + d.meal
            && d.dayStart is timestamp && currentSeoulDay(d)
            && d.createdAt is timestamp && d.updatedAt == request.time;
        }
        allow read: if b3Owner(uid);
        allow create: if b3Owner(uid) && validMeal(request.resource.data)
          && exists(/databases/$(database)/documents/bapmunnaAccounts/$(uid))
          && request.resource.data.createdAt == request.time;
        allow update: if b3Owner(uid) && validMeal(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if b3Owner(uid);
      }
    }
    // Every other document is denied by default.
  }
}
