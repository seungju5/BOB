    // BEGIN BAPMUNNA ACCOUNT V3
    function b3Verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function b3Owner(uid) { return b3Verified() && request.auth.uid == uid; }
    function b3Staff() {
      return b3Verified()
        && exists(/databases/$(database)/documents/bapmunnaStaff/$(request.auth.uid))
        && get(/databases/$(database)/documents/bapmunnaStaff/$(request.auth.uid)).data.role in ['owner','manager'];
    }
    function b3Profile(d,uid) {
      return d.keys().hasAll(['ownerUid','email','displayName','consentVersion','createdAt','updatedAt'])
        && d.keys().hasOnly(['ownerUid','email','displayName','consentVersion','createdAt','updatedAt'])
        && d.ownerUid == uid && d.email == request.auth.token.email
        && d.displayName is string && d.displayName.size() >= 2 && d.displayName.size() <= 30
        && d.consentVersion == '2026-10-16' && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    match /bapmunnaAccounts/{uid} {
      allow read: if b3Owner(uid);
      allow create: if b3Owner(uid) && b3Profile(request.resource.data,uid)
        && request.resource.data.createdAt == request.time;
      allow update: if b3Owner(uid) && b3Profile(request.resource.data,uid)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
      // Basic preferences belong only to the verified account owner. They do
      // not create a care household, sharing grant, or senior consent record.
      match /preferences/household {
        function validHousehold(d) {
          return d.keys().hasAll(['ownerUid','relation','alias','residentCount','hasPet','updatedAt'])
            && d.keys().hasOnly(['ownerUid','relation','alias','residentCount','hasPet','updatedAt'])
            && d.ownerUid == uid
            && d.relation in ['mother','father','parents','other']
            && d.alias is string && d.alias.size() >= 1 && d.alias.size() <= 30
            && d.alias == d.alias.trim()
            && d.residentCount is int && d.residentCount >= 1 && d.residentCount <= 6
            && d.hasPet is bool && d.updatedAt == request.time;
        }
        allow read: if b3Owner(uid);
        allow create,update: if b3Owner(uid) && validHousehold(request.resource.data);
        allow delete: if b3Owner(uid);
      }
      match /meals/{mealId} {
        function currentSeoulDay(d) {
          let parts = d.day.split('-');
          let today = request.time + duration.value(9,'h');
          return int(parts[0]) == today.year() && int(parts[1]) == today.month()
            && int(parts[2]) == today.day()
            && d.dayStart == today.date() - duration.value(9,'h');
        }
        function validMeal(d) {
          return d.keys().hasAll(['ownerUid','day','meal','kind','dayStart','createdAt','updatedAt'])
            && d.keys().hasOnly(['ownerUid','day','meal','kind','dayStart','createdAt','updatedAt'])
            && d.ownerUid == uid && d.day is string && d.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && d.meal in ['breakfast','lunch','dinner'] && d.kind in ['home','outside']
            && mealId == d.day + '_' + d.meal
            && d.dayStart is timestamp && currentSeoulDay(d)
            && d.createdAt is timestamp && d.updatedAt == request.time;
        }
        allow read: if b3Owner(uid);
        allow create: if b3Owner(uid) && validMeal(request.resource.data)
          && exists(/databases/$(database)/documents/bapmunnaAccounts/$(uid))
          && request.resource.data.createdAt == request.time;
        allow update: if b3Owner(uid) && validMeal(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if b3Owner(uid);
      }
    }
    match /bapmunnaCRMContacts/{uid} {
      function validContact(d) {
        return d.keys().hasAll(['ownerUid','email','displayName','consentVersion','createdAt','updatedAt','source','lastLoginAt'])
          && d.keys().hasOnly(['ownerUid','email','displayName','consentVersion','createdAt','updatedAt','source','lastLoginAt'])
          && d.ownerUid == uid && d.email == request.auth.token.email
          && d.displayName is string && d.displayName.size() >= 2 && d.displayName.size() <= 30
          && d.consentVersion == '2026-10-16' && d.source == 'bapmunna'
          && d.createdAt is timestamp && d.updatedAt == request.time && d.lastLoginAt == request.time;
      }
      allow get: if b3Owner(uid) || b3Staff();
      allow list: if b3Staff();
      allow create: if b3Owner(uid) && validContact(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if b3Owner(uid) && validContact(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }
    match /bapmunnaCRMNotes/{uid} {
      allow read: if b3Staff();
      allow create,update: if b3Staff()
        && request.resource.data.keys().hasAll(['ownerUid','stage','note','updatedBy','updatedAt'])
        && request.resource.data.keys().hasOnly(['ownerUid','stage','note','updatedBy','updatedAt'])
        && request.resource.data.ownerUid == uid
        && request.resource.data.stage in ['new','contacted','active','paused']
        && request.resource.data.note is string && request.resource.data.note.size() <= 1000
        && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /bapmunnaStaff/{uid} {
      allow get: if b3Owner(uid);
      allow list,write: if false;
    }
    // Server-only SmartThings collections. Neither owners nor CRM staff can
    // read tokens, OAuth state, or device metadata directly from a browser.
    match /bapmunnaSmartThingsConnections/{id} { allow read,write: if false; }
    match /bapmunnaSmartThingsInstallations/{id} { allow read,write: if false; }
    match /bapmunnaSmartThingsStates/{id} { allow read,write: if false; }
    match /bapmunnaSmartThingsLocks/{id} { allow read,write: if false; }
    match /bapmunnaSmartThingsReceipts/{id} { allow read,write: if false; }
    // END BAPMUNNA ACCOUNT V3
