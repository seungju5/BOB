      allow create: if validToken(request.resource.data) && b4Owner(request.resource.data.householdId)
        && getAfter(/databases/$(database)/documents/bapmunnaHouseholds/$(request.resource.data.householdId)).data.activeInviteHash == tokenHash
        && getAfter(/databases/$(database)/documents/bapmunnaHouseholds/$(request.resource.data.householdId)).data.consentEnabled
        && request.resource.data.sharingEpoch == b4Home(request.resource.data.householdId).sharingEpoch && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time && request.resource.data.expiresAt > request.time && request.resource.data.expiresAt <= request.time + duration.value(1,'d')
        && request.resource.data.acceptedBy == null && request.resource.data.acceptedAt == null && request.resource.data.revokedAt == null;
      allow update: if (b4Owner(resource.data.householdId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revokedAt']) && request.resource.data.revokedAt == request.time)
        || (available(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acceptedBy','acceptedAt']) && request.resource.data.acceptedBy == request.auth.uid && request.resource.data.acceptedAt == request.time
          && getAfter(/databases/$(database)/documents/bapmunnaHouseholds/$(resource.data.householdId)/members/$(request.auth.uid)).data.inviteHash == tokenHash
          && getAfter(/databases/$(database)/documents/bapmunnaHouseholds/$(resource.data.householdId)/members/$(request.auth.uid)).data.role == resource.data.role);
      allow delete: if b4Owner(resource.data.householdId);
    }
    match /bapmunnaSystem/{document=**} { allow read,write: if false; }
    // END BAPMUNNA CARE DOMAIN
    // Everything outside the Bapmunna namespaces is closed.
    match /{document=**} { allow read, write: if false; }
  }
}
