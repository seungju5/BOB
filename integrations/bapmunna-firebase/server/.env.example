# Server only. Do not put these in NEXT_PUBLIC_ variables or browser config.
FIREBASE_PROJECT_ID=ku-gpa
APP_URL=https://impact-series.web.app/bapmunna/carer/
# Same-origin Hosting rewrite /api/smartthings/** -> this Cloud Run service.
PUBLIC_ORIGIN=https://impact-series.web.app
SMARTTHINGS_APP_ID=
SMARTTHINGS_CLIENT_ID=
SMARTTHINGS_CLIENT_SECRET=
# 32 random bytes, base64-encoded. Store in Google Secret Manager.
SMARTTHINGS_ENCRYPTION_KEY=
# Existing OAuth-In apps use /oauth; use /v1/oauth only for a verified new API Access App.
SMARTTHINGS_OAUTH_PREFIX=/oauth
PORT=8080
