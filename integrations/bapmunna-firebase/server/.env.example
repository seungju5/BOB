# Local integration server. Inject server secrets only in its own environment.
FIREBASE_PROJECT_ID=
APP_URL=http://127.0.0.1:8080/connect/
PUBLIC_ORIGIN=http://127.0.0.1:8080
SMARTTHINGS_APP_ID=
SMARTTHINGS_CLIENT_ID=
SMARTTHINGS_CLIENT_SECRET=
# Base64-encoded 32-byte key.
SMARTTHINGS_ENCRYPTION_KEY=
SMARTTHINGS_OAUTH_PREFIX=/oauth
SMARTTHINGS_CONNECTION_ENABLED=false
PORT=8080

# Optional adapters. Use exact HTTPS origins when configuring them.
KAKAO_API_ORIGIN=
WALKING_API_ORIGIN=
BAPMUNNA_WEB_ORIGIN=
