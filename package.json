{
  "name": "warming-up-bapmunna",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "demo:smartthings": "node scripts/smartthings-demo.mjs",
    "build": "next build --webpack",
    "release:hosting": "python3 scripts/release-team-build.py",
    "check:types": "tsc --noEmit",
    "check:smartthings": "node scripts/check-smartthings.mjs",
    "check:personal-info": "node scripts/check-personal-info.mjs",
    "test": "vitest run",
    "test:accounts": "node --test firebase/tests/account-rules.test.mjs",
    "test:domain": "node --test packages/power-pattern/*.test.mjs packages/power-pattern/research/*.test.mjs packages/walking-hearts/test/*.test.mjs && npm run test:smartthings",
    "test:smartthings": "npm ci --prefix server/smartthings --no-audit --no-fund && npm --prefix server/smartthings test",
    "lint": "eslint",
    "pilot:import": "node server/smartthings/pilot/import.mjs",
    "pilot:cleanup": "node server/smartthings/pilot/cleanup.mjs"
  },
  "dependencies": {
    "@bapmunna/phone-steps": "file:packages/phone-steps",
    "@capacitor/core": "8.6.2",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/kor": "1.0.0",
    "firebase": "12.18.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
