{
  "name": "bapmutna",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:design && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:firebase": "node scripts/sync-firebase.mjs",
    "check:firebase-sync": "node scripts/sync-firebase.mjs --check",
    "dev:firebase": "npm --prefix integrations/bapmunna-firebase run dev",
    "build:firebase": "npm run sync:firebase && npm --prefix integrations/bapmunna-firebase run build",
    "test:firebase": "npm run check:firebase-sync && npm --prefix integrations/bapmunna-firebase test && npm --prefix integrations/bapmunna-firebase run test:editions && npm --prefix integrations/bapmunna-firebase run test:manage && node --test integrations/bapmunna-firebase/tests/parity.test.mjs integrations/bapmunna-firebase/tests/experience.test.mjs integrations/bapmunna-firebase/tests/session-storage.test.mjs",
    "test:smartthings": "npm --prefix integrations/bapmunna-firebase/server test",
    "sync:design": "node scripts/sync-design.mjs",
    "check:design": "node scripts/sync-design.mjs --check",
    "check:smartthings": "node integrations/bapmunna-firebase/scripts/check-smartthings-readiness.mjs",
    "harness": "node scripts/harness.mjs",
    "harness:doctor": "node scripts/harness.mjs doctor",
    "harness:plan": "node scripts/harness.mjs plan",
    "harness:check": "node scripts/harness.mjs check",
    "test:harness": "node --test --test-reporter=tap tests/harness/*.test.mjs",
    "build:office": "node workspaces/super-members/scripts/build.mjs",
    "test:office": "npm run build:office && node --test workspaces/super-members/*.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
