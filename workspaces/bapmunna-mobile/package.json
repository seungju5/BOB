{
  "name": "bapmunna-mobile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare:web": "node scripts/prepare-web.mjs",
    "prepare:brand": "node scripts/prepare-brand.mjs",
    "doctor": "node scripts/release.mjs doctor",
    "build:android": "node scripts/release.mjs android-debug",
    "build:android:unsigned": "node scripts/release.mjs android-release-unsigned",
    "build:android:signed": "node scripts/release.mjs android-release-signed",
    "build:android:apk": "node scripts/release.mjs android-apk-signed",
    "bundle:ios-source": "node scripts/release.mjs ios-source",
    "verify": "node scripts/verify-shell.mjs",
    "test": "node --test tests/*.test.mjs",
    "sync": "npm run verify && cap sync",
    "open:android": "cap open android",
    "open:ios": "cap open ios"
  },
  "dependencies": {
    "@bapmunna/phone-steps": "file:../../packages/phone-steps",
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2"
  },
  "devDependencies": { "@capacitor/cli": "8.6.2" },
  "engines": { "node": ">=22" }
}
